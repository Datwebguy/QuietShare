# Web3Auth Plug and Play Client ID from https://dashboard.web3auth.io
# (Coston2 chain config is passed directly in code — see lib/web3auth.ts — no
# dashboard chain setup needed with the classic v9 SDK.)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Real FXRP FAsset on Coston2 (6 decimals): 0x0b6A3645c240605887a5532109323A3E12273dc7
# Resolve it yourself via FlareContractRegistry (0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019)
# -> getContractAddressByName("AssetManagerFXRP") -> fAsset(). Faucet-available
# at https://faucet.flare.network/coston2, no minting flow needed.
# Or from `npm --prefix contracts run deploy:coston2` for the MockStable (qUSD) stand-in.
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=

# Optional display-name registry, independent of PotVault (see
# contracts/contracts/UsernameRegistry.sol) — from `npm --prefix contracts
# run deploy:username-registry`. Purely cosmetic: falls back to the raw
# address anywhere a name hasn't been set.
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=

# From deploying fce-extension/contracts/QuietShareInstructionSender.sol
# (fce-extension/scripts/pre-build.sh writes this to config/extension.env)
NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=

# The FCE extension's public tunnel URL (ngrok/cloudflared), same value as
# EXT_PROXY_URL in fce-extension/.env
NEXT_PUBLIC_EXT_PROXY_URL=

# From `npm --prefix fce-extension/typescript run keygen` — TEE_PUBLIC_KEY only
NEXT_PUBLIC_TEE_PUBLIC_KEY=

# Per-instruction fee charged by TeeExtensionRegistry, in wei. 1000000 is what
# fce-extension/tools/pkg/utils/instructions.go hardcodes for testnet — verify
# against your deployed registry (OperationFeesFacet) before relying on it.
NEXT_PUBLIC_INSTRUCTION_FEE_WEI=1000000

NEXT_PUBLIC_COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# LOCAL DEMO MODE — see fce-extension/typescript/src/local-demo-server.ts and README.
# Bypasses the on-chain FCC instruction relay (needs Flare-internal indexer infra
# we don't have) and talks directly to the local demo server running the same
# handler code. Run it with: npm --prefix fce-extension/typescript run demo
NEXT_PUBLIC_LOCAL_DEMO_MODE=true
NEXT_PUBLIC_LOCAL_DEMO_URL=https://quietshare-demo-tee.fly.dev
