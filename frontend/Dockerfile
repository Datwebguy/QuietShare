# Production image for the QuietShare frontend (Next.js standalone output).
FROM node:20-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# NEXT_PUBLIC_* vars are inlined into the JS bundle at build time, so they must
# be build args, not runtime env vars.
ARG NEXT_PUBLIC_WEB3AUTH_CLIENT_ID
ARG NEXT_PUBLIC_TOKEN_ADDRESS
ARG NEXT_PUBLIC_VAULT_ADDRESS
ARG NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS
ARG NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS
ARG NEXT_PUBLIC_EXT_PROXY_URL
ARG NEXT_PUBLIC_TEE_PUBLIC_KEY
ARG NEXT_PUBLIC_INSTRUCTION_FEE_WEI
ARG NEXT_PUBLIC_COSTON2_RPC_URL
ARG NEXT_PUBLIC_LOCAL_DEMO_MODE
ARG NEXT_PUBLIC_LOCAL_DEMO_URL
ENV NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=$NEXT_PUBLIC_WEB3AUTH_CLIENT_ID \
    NEXT_PUBLIC_TOKEN_ADDRESS=$NEXT_PUBLIC_TOKEN_ADDRESS \
    NEXT_PUBLIC_VAULT_ADDRESS=$NEXT_PUBLIC_VAULT_ADDRESS \
    NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=$NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS \
    NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS=$NEXT_PUBLIC_INSTRUCTION_SENDER_ADDRESS \
    NEXT_PUBLIC_EXT_PROXY_URL=$NEXT_PUBLIC_EXT_PROXY_URL \
    NEXT_PUBLIC_TEE_PUBLIC_KEY=$NEXT_PUBLIC_TEE_PUBLIC_KEY \
    NEXT_PUBLIC_INSTRUCTION_FEE_WEI=$NEXT_PUBLIC_INSTRUCTION_FEE_WEI \
    NEXT_PUBLIC_COSTON2_RPC_URL=$NEXT_PUBLIC_COSTON2_RPC_URL \
    NEXT_PUBLIC_LOCAL_DEMO_MODE=$NEXT_PUBLIC_LOCAL_DEMO_MODE \
    NEXT_PUBLIC_LOCAL_DEMO_URL=$NEXT_PUBLIC_LOCAL_DEMO_URL

COPY . .
RUN npm run build

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production PORT=8080

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 8080
CMD ["node", "server.js"]
