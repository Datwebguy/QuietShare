{
  "name": "quietshare-fce-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QuietShare's Flare Confidential Compute extension (private per-member pot ledger)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
